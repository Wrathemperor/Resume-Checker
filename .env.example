# =============================================
# AI Resume Checker — Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- LLM ---
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_checker

# --- App ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt,docx
SHORTLIST_THRESHOLD=7
DEBUG=false

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
